# Copy to secrets.yaml (gitignored) and fill in. With the HA ESPHome add-on,
# add these keys to the add-on's shared /config/esphome/secrets.yaml instead.
#
#   uncharted_api_key           — generate at https://esphome.io/components/api.html
#                                 or: openssl rand -base64 32
#   uncharted_ota_password      — any string
#   uncharted_fallback_password — AP password if WiFi fails, min 8 chars

wifi_ssid: "YourSSID"
wifi_password: "YourWiFiPassword"
uncharted_api_key: "base64-32-bytes-here"
uncharted_ota_password: "choose-something"
uncharted_fallback_password: "fallback123"
